{
  "filesystem.watcher.enabled": true,
  "filesystem.watcher.maxFilesToWatch": 200,
  "filesystem.exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/.git/**"
  ],
  "indexing.autoIndexOnLoad": false,
  "indexing.maxFileSizeMB": 0.1,
  "context.includeTerminalHistory": false,
  "context.includeGitStatus": false,
  "context.autoIncludeOpenTabs": false
  "context.includeTerminalHistory": false,
  "context.includeGitStatus": false,
  "context.autoIncludeOpenTabs": false,
  "indexing.maxFileSizeMB": 0.2,
}
